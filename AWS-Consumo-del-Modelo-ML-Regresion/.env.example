# ==============================================================================
# Plantilla de configuración. Copia este archivo como .env y rellena los valores:
#
#     cp .env.example .env
#
# El .env está en el .gitignore y NO debe subirse nunca al repositorio.
# ==============================================================================

# --- Credenciales del usuario IAM que invoca el endpoint -----------------------
# Necesita el permiso sagemaker:InvokeEndpoint sobre el endpoint.
# Consola de AWS -> IAM -> Usuarios -> Credenciales de seguridad -> Crear access key
AWS_ACCESS_KEY_ID=tu_access_key_id
AWS_SECRET_ACCESS_KEY=tu_secret_access_key

# --- Región --------------------------------------------------------------------
# Tiene que ser la MISMA región donde está el endpoint y el bucket de S3.
# Si no coinciden, SageMaker falla con un error que parece de permisos IAM
# pero en realidad es de región (ver README-entrenamiento-local.md, sección 6b).
AWS_REGION=us-east-2

# --- Endpoint ------------------------------------------------------------------
# Lo publica la última sección de linear-learner-houses-LOCAL.ipynb,
# que además actualiza este valor en el .env automáticamente.
SAGEMAKER_ENDPOINT_NAME=linear-learner-houses-local

# --- Opcional: endpoint de XGBoost, si también lo despliegas -------------------
#SAGEMAKER_XGBOOST_ENDPOINT_NAME=nombre-del-endpoint-xgboost
