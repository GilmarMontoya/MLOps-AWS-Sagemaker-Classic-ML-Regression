# Copia este archivo como .env y rellena los valores:   cp .env.example .env
# El .env NO se sube a git ni entra en la imagen Docker (.dockerignore).

# --- Credenciales (opcional) ---------------------------------------------------
# Si las dejas vacías, boto3 usa ~/.aws (aws configure). En ECS se usa el rol de la tarea.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Región y endpoint -----------------------------------------------------------
AWS_REGION=us-east-2
SAGEMAKER_ENDPOINT_NAME=qwen3-4b-g5

# --- Comportamiento del asistente ------------------------------------------------
SYSTEM_PROMPT=Eres un asistente útil y conciso. Responde en español.
